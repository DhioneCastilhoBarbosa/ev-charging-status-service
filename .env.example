
POSTGRES_URL=postgres://postgres:postgres@db:5432/charging?sslmode=disable
INTELBRAS_BASE_URL=https://cs-test.use-move.com/api/v1
API_KEY=""
# Chave para criptografar senha e api_key no banco. Pode ser: UUID, senha, ou base64(32 bytes). Se vazia, dados ficam em texto.
ENCRYPTION_KEY=""
# Segredo para assinar token curto do websocket (fallback: API_KEY).
WS_JWT_SECRET=""
# TTL do token websocket em segundos.
WS_TOKEN_TTL_SECONDS=300
# Intervalo de publicação do WebSocket em segundos (default 180 = 3 min, igual ao worker).
WS_PUBLISH_INTERVAL_SECONDS=180
