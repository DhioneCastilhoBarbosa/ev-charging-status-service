
POSTGRES_URL=postgres://postgres:postgres@db:5432/charging?sslmode=disable
INTELBRAS_BASE_URL=https://cs-test.use-move.com/api/v1
# Limite de GET /chargepoints por minuto neste processo (margem sob 60). Use 0 para desativar.
INTELBRAS_CHARGEPOINT_MAX_RPM=55
API_KEY=""
# Chave para criptografar senha e api_key no banco. Pode ser: UUID, senha, ou base64(32 bytes). Se vazia, dados ficam em texto.
ENCRYPTION_KEY=""
# Segredo para assinar token curto do websocket (fallback: API_KEY).
WS_JWT_SECRET=""
# TTL do token websocket em segundos.
WS_TOKEN_TTL_SECONDS=300
# Assina STOMP /topic/status/chargeBox/{uuid} no CSMS e envia mudanças (status/errorCode/erroInfo) pelo WebSocket.
CSMS_STATUS_STOMP_ENABLED=true
# Prefixo SockJS no mesmo host de INTELBRAS_BASE_URL (ex.: /ws).
CSMS_SOCKJS_PREFIX=/ws
